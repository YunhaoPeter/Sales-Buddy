  "type": "module",
  "scripts": {
    "dev": "tsx apps/server/src/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx apps/server/src/index.ts --production",
    "db:migrate": "tsx apps/server/src/cli.ts migrate",
    "seed": "tsx apps/server/src/cli.ts seed",
    "knowledge:reindex": "tsx apps/server/src/cli.ts reindex",
    "scenario:reset": "tsx apps/server/src/cli.ts reset",
    "mcp:stdio": "tsx apps/server/src/stdio.ts",
